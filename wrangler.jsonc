{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "progresql",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-23",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1,
    },
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "progresql.cotsakis.com",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "progresql",
      "database_id": "34ba2cfc-f847-4cf2-aa0a-403490e164d7",
      "migrations_dir": "migrations",
    },
  ],
  "secrets": {
    "required": [
      "AUTH_USERNAME",
      "AUTH_PASSWORD_PARAMETERS",
      "AUTH_PASSWORD_VERIFIER",
      "AUTH_PEPPER",
      "AUTH_TOTP_SECRET",
    ],
  },
}
