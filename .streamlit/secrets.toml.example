# Copy this file to .streamlit/secrets.toml locally. On Streamlit Community
# Cloud, paste equivalent values into the app's Secrets settings instead.
# Never commit the real secrets.toml file.

# PostgreSQL URL from your hosted database provider. SSL is normally required.
database_url = "postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Run `uv run python scripts/setup_local_auth.py` to generate these values and
# a QR image for Microsoft Authenticator. Never commit the real values.
auth_username = "your-private-username"
auth_password_hash = "GENERATED_ARGON2_HASH"
auth_totp_secret = "GENERATED_TOTP_SECRET"
