{
  "name": "progresql",
  "private": true,
  "version": "2.0.2",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n ui,api \"vite --host 127.0.0.1\" \"wrangler dev --ip 127.0.0.1 --local-upstream 127.0.0.1 --upstream-protocol http --port 8787 --var LOCAL_DEV:enabled\"",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "db:migrate": "wrangler d1 migrations apply progresql --local",
    "deploy": "npm run build && wrangler deploy --secrets-file .env.auth-upload.json",
    "preview": "wrangler dev --ip 127.0.0.1 --local-upstream 127.0.0.1 --upstream-protocol http --port 8787 --var LOCAL_DEV:enabled",
    "test:browser": "npm run build && playwright test",
    "format": "prettier --write src worker shared tests-web *.ts *.json *.jsonc scripts/*.mjs",
    "predeploy": "node scripts/check-deploy.mjs",
    "typegen": "wrangler types worker-configuration.d.ts --include-runtime false --strict-vars false"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hash-wasm": "^4.12.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "miniflare": "^5.20260921.0-alpha",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.0.0"
  }
}
